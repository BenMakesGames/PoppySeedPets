<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PoppySeedPets.Editor.Sections.GroupedStrings"
             x:Class="PoppySeedPets.Editor.Sections.GroupedStrings.GroupedStringsView">
  <Grid>
    <SelectableTextBlock x:Name="LoadError" IsVisible="False" Foreground="#FF8A80" TextWrapping="Wrap" />

    <Grid x:Name="Editor" ColumnDefinitions="300,16,*" RowDefinitions="Auto,8,*,8,Auto">
      <TextBox x:Name="FilterBox" PlaceholderText="Filter headings and text" />

      <ListBox x:Name="GroupList" Grid.Row="2">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:GroupRow">
            <TextBlock Text="{Binding Heading}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <DockPanel Grid.Row="4">
        <Button x:Name="AddGroupButton" DockPanel.Dock="Left" Content="Add group" />
        <TextBlock x:Name="Summary" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />
      </DockPanel>

      <TextBox x:Name="HeadingBox" Grid.Column="2" PlaceholderText="Heading" FontWeight="SemiBold" />

      <ScrollViewer Grid.Column="2" Grid.Row="2">
        <StackPanel x:Name="Lines" Spacing="6" Margin="0,0,16,0" />
      </ScrollViewer>

      <StackPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal" Spacing="8">
        <Button x:Name="AddLineButton" Content="Add line" />
        <Button x:Name="DeleteGroupButton" Content="Delete group" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
